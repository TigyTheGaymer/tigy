{
  "name": "public-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/public-e2e/src",
  "tags": ["e2e"],
  "implicitDependencies": ["public", "firebase"],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["public"],
          "target": "build"
        }
      ],
      "cache": true,
      "parallelism": false,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/firebase.json",
        "{workspaceRoot}/firebase/storage.rules",
        "{workspaceRoot}/firebase/seed/**/*",
        "{workspaceRoot}/design/mockups/assets/**/*",
        {
          "externalDependencies": ["@playwright/test", "firebase-tools"]
        }
      ],
      "outputs": [
        "{workspaceRoot}/dist/.playwright/apps/public-e2e/test-output",
        "{workspaceRoot}/dist/.playwright/apps/public-e2e/playwright-report"
      ],
      "options": {
        "command": "firebase emulators:exec --only firestore,storage --project demo-tigy \"playwright test --config apps/public-e2e/playwright.config.mts\"",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
