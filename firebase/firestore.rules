rules_version = '2';

// Only the owner may use the database from a browser: the account with the
// custom claim `owner: true`, which the sign-up blocking function sets. Public
// pages read through the site's server with the Admin SDK, which these rules
// do not apply to. See openspec/changes/define-data-model/design.md, D8.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.token.get('owner', false) == true;
    }

    match /{document=**} {
      allow read: if isOwner();
    }

    // Deleting a person goes through a function that first checks that no
    // image credits them, so browsers may not delete people.
    match /people/{personId} {
      allow create, update: if isOwner();
    }

    match /images/{imageId} {
      allow create, update, delete: if isOwner();
    }

    // Upload records are written only by the processing function; the owner
    // clears a row by deleting its record.
    match /uploads/{uploadId} {
      allow delete: if isOwner();
    }

    // Everything under meta is derived and written only by Cloud Functions.
  }
}
