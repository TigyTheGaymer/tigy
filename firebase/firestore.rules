rules_version = '2';

// Only the owner may use the database from a browser: the account with the
// custom claim `owner: true`, which the sign-up blocking function sets. Public
// pages read through the site's server with the Admin SDK, which these rules
// do not apply to. See openspec/changes/define-data-model/design.md, D8.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.token.get('owner', false) == true;
    }

    match /{document=**} {
      allow read: if isOwner();
    }

    // The rules check types and which fields change, not meaning: the admin
    // keeps sortDate in step with date and normalises tags.
    function isValidPerson(personId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'links', 'avatar', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.trim().size() > 0
        && d.links is list && d.links.size() <= 20
        && (!('avatar' in d) || d.avatar == 'people/' + personId + '/avatar.webp');
    }

    // Deleting a person goes through a function that first checks that no
    // image credits them, so browsers may not delete people.
    match /people/{personId} {
      allow create: if isOwner() && isValidPerson(personId);
      allow update: if isOwner() && isValidPerson(personId)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);
    }

    function isAbsentOr(d, key, type) {
      return !(key in d)
        || (type == 'string' && d[key] is string)
        || (type == 'list' && d[key] is list && d[key].size() <= 50);
    }

    function isValidImageUpdate() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly([
          'title', 'description', 'date', 'sortDate', 'published', 'nsfw',
          'artistIds', 'characterIds', 'tags', 'updatedAt'])
        && isAbsentOr(d, 'title', 'string')
        && isAbsentOr(d, 'description', 'string')
        && (!('date' in d) || (d.date is string && d.date.matches('^[0-9]{4}(-[0-9]{2}){0,2}$')))
        && d.sortDate is string && d.sortDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.published is bool
        && d.nsfw is bool
        && isAbsentOr(d, 'artistIds', 'list')
        && isAbsentOr(d, 'characterIds', 'list')
        && isAbsentOr(d, 'tags', 'list')
        && d.updatedAt == request.time;
    }

    // Artworks come only from processing an upload, which uses the Admin SDK,
    // so a browser can never create one without files.
    match /images/{imageId} {
      allow update: if isOwner() && isValidImageUpdate();
      allow delete: if isOwner();
    }

    // Upload records are written only by the processing function; the owner
    // clears a row by deleting its record.
    match /uploads/{uploadId} {
      allow delete: if isOwner();
    }

    // Everything under meta is derived and written only by Cloud Functions.
  }
}
