{
  "name": "firebase",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "tags": ["backend"],
  "namedInputs": {
    "firebaseConfig": [
      "{workspaceRoot}/firebase.json",
      "{projectRoot}/firestore.rules",
      "{projectRoot}/storage.rules",
      "{projectRoot}/firestore.indexes.json"
    ]
  },
  "targets": {
    "emulators": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": [
        {
          "projects": ["functions"],
          "target": "build"
        }
      ],
      "inputs": ["firebaseConfig"],
      "options": {
        "command": "firebase emulators:start --project demo-tigy",
        "cwd": "{workspaceRoot}"
      }
    },
    "seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r @swc-node/register firebase/seed/seed.ts",
        "cwd": "{workspaceRoot}",
        "env": {
          "SWC_NODE_PROJECT": "tsconfig.base.json",
          "FIRESTORE_EMULATOR_HOST": "127.0.0.1:8080",
          "FIREBASE_STORAGE_EMULATOR_HOST": "127.0.0.1:9199"
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "parallelism": false,
      "inputs": [
        "firebaseConfig",
        "{projectRoot}/tests/**/*",
        "{projectRoot}/vitest.rules.mts",
        {
          "externalDependencies": ["@firebase/rules-unit-testing", "vitest"]
        }
      ],
      "options": {
        "command": "firebase emulators:exec --only firestore,storage --project demo-tigy \"vitest run --config firebase/vitest.rules.mts\"",
        "cwd": "{workspaceRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/tests/**/*",
        "{projectRoot}/seed/**/*",
        "{projectRoot}/vitest.rules.mts",
        "{projectRoot}/tsconfig.json",
        {
          "externalDependencies": ["typescript"]
        }
      ],
      "options": {
        "command": "tsc -p {projectRoot}/tsconfig.json --noEmit",
        "cwd": "{workspaceRoot}"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "firebase deploy --only firestore,storage --project tigy-165cc --non-interactive",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
