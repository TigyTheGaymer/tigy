{
  "name": "firebase",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "tags": ["backend"],
  "namedInputs": {
    "firebaseConfig": [
      "{workspaceRoot}/firebase.json",
      "{projectRoot}/firestore.rules",
      "{projectRoot}/storage.rules",
      "{projectRoot}/firestore.indexes.json"
    ]
  },
  "targets": {
    "emulators": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": [{ "projects": ["functions"], "target": "build" }],
      "inputs": ["firebaseConfig"],
      "options": {
        "command": "firebase emulators:start --project demo-tigy",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "firebaseConfig",
        "{projectRoot}/tests/**/*",
        "{projectRoot}/vitest.rules.mts",
        { "externalDependencies": ["@firebase/rules-unit-testing", "vitest"] }
      ],
      "options": {
        "command": "firebase emulators:exec --only firestore,storage --project demo-tigy \"vitest run --config firebase/vitest.rules.mts\"",
        "cwd": "{workspaceRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/tests/**/*",
        "{projectRoot}/vitest.rules.mts",
        "{projectRoot}/tsconfig.json",
        { "externalDependencies": ["typescript"] }
      ],
      "options": {
        "command": "tsc -p {projectRoot}/tsconfig.json --noEmit",
        "cwd": "{workspaceRoot}"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "firebase deploy --only firestore,storage --project tigy-165cc --non-interactive",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
