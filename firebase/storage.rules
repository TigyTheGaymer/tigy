rules_version = '2';

// Anyone may fetch an image's files, but no browser may write them: they
// come only from the upload processing function, which uses the Admin SDK.
// Listing is not public, so the IDs of unpublished images stay unknown.
// Everything else is denied.
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner() {
      return request.auth != null && request.auth.token.get('owner', false) == true;
    }

    match /images/{imageId}/{fileName} {
      allow get;
    }

    // The admin sets the content type from the file's first bytes; processing
    // checks the bytes and the size again. 50 MB and 200 MB are
    // MAX_IMAGE_BYTES and MAX_VIDEO_BYTES in @tigy/uploads.
    match /uploads/{uploadId}/source {
      allow create: if isOwner()
        && resource == null
        && (
          (request.resource.contentType.matches('image/(jpeg|png|gif|webp)')
            && request.resource.size <= 50 * 1024 * 1024)
          || (request.resource.contentType.matches('video/(mp4|quicktime|webm)')
            && request.resource.size <= 200 * 1024 * 1024)
        );
    }

    // One avatar per person, fetchable but not listable, like the images.
    // The admin makes it as a WebP of at most 512 pixels a side.
    match /people/{personId}/avatar.webp {
      allow get;
      allow create, update: if isOwner()
        && request.resource.size <= 1024 * 1024
        && request.resource.contentType == 'image/webp';
      allow delete: if isOwner();
    }
  }
}
