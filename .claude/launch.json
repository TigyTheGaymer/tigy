{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mockups",
      "runtimeExecutable": "node",
      "runtimeArgs": ["design/mockups/serve.mjs"],
      "port": 4321
    },
    {
      "name": "public",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["nx", "run", "public-e2e:preview"],
      "port": 4300
    },
    {
      "name": "public-on-emulators",
      "runtimeExecutable": "node",
      "runtimeArgs": ["dist/apps/public/server/server.mjs"],
      "env": {
        "PORT": "4300",
        "GCLOUD_PROJECT": "demo-tigy",
        "FIREBASE_CONFIG": "{\"projectId\":\"demo-tigy\",\"storageBucket\":\"demo-tigy.appspot.com\"}",
        "FIRESTORE_EMULATOR_HOST": "127.0.0.1:8080",
        "FIREBASE_STORAGE_EMULATOR_HOST": "127.0.0.1:9199"
      },
      "port": 4300
    },
    {
      "name": "emulators",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["nx", "run", "firebase:emulators"],
      "port": 4000
    },
    {
      "name": "emulators-admin",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "firebase",
        "emulators:start",
        "--only",
        "auth,functions,firestore,storage",
        "--project",
        "demo-tigy"
      ],
      "port": 4000
    },
    {
      "name": "admin",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["nx", "serve", "admin"],
      "port": 4201
    }
  ]
}
